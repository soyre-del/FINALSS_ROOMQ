# Copy this file to .env and fill in private values. Do NOT commit .env.
# ----------------------------------------------------------------------------

# MySQL root password (used only for container init and healthcheck).
MYSQL_ROOT_PASSWORD=change-me-root-password

# Application database credentials. The backend connects with these.
ROOMQ_DB_NAME=roomq
ROOMQ_DB_USER=roomq
ROOMQ_DB_PASSWORD=change-me-db-password

# Initial administrator account, provisioned the first time the DB is created.
# Password must be at least 12 characters.
ROOMQ_ADMIN_USERNAME=admin
ROOMQ_ADMIN_PASSWORD=change-me-admin-password

# Setup key that protects admin self-registration (/api/register-admin).
# Must be at least 16 characters. Leave blank to disable admin self-signup.
ROOMQ_ADMIN_SIGNUP_KEY=change-me-admin-signup-key-16chars

# Host ports (left side of the mapping). Change if these are already in use.
BACKEND_HOST_PORT=8080
MYSQL_HOST_PORT=3307

# phpMyAdmin web UI port (published on localhost only, like MySQL).
PHPMYADMIN_HOST_PORT=8081

# Campus time zone, used for reservation rules such as "no past dates".
ROOMQ_TIMEZONE=Asia/Manila

# Session cookie Secure flag: auto (Secure only on HTTPS requests), true, false.
ROOMQ_COOKIE_SECURE=auto
# Set to true only when running behind an HTTPS reverse proxy that sets
# X-Forwarded-Proto / X-Forwarded-For.
ROOMQ_TRUST_PROXY=false

# Limits for reservations made by user (non-admin) accounts.
ROOMQ_RESERVATION_MAX_MINUTES=240
ROOMQ_RESERVATION_HORIZON_DAYS=90
ROOMQ_RESERVATION_MAX_ACTIVE=5
